#!/bin/bash
set -euo pipefail

# If systemd passes ENV_NAME, it wins; otherwise fall back to Ansible-provided env_name.
ENV_NAME="${ENV_NAME:-{{ env_name | default('UNKNOWN') }}}"

HOST="$(hostname)"
IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
CPU="$(nproc 2>/dev/null || echo N/A)"

RAM_MB="$(free -m 2>/dev/null | awk '/^Mem:/ {print $2}')"
if [[ -n "${RAM_MB:-}" ]]; then
  RAM_GB="$(awk "BEGIN {printf \"%.1f\", ${RAM_MB}/1024}")"
else
  RAM_GB="N/A"
fi

DISK_TOTAL="$(df -hP -x tmpfs -x devtmpfs -x sysfs -x efivarfs --total 2>/dev/null | awk 'END {print $2}')"
DISK_FREE="$(df -hP -x tmpfs -x devtmpfs -x sysfs -x efivarfs --total 2>/dev/null | awk 'END {print $4}')"
MOUNT_LINES="$(df -hP -x tmpfs -x devtmpfs -x sysfs -x efivarfs 2>/dev/null | awk 'NR>1 {printf "  %-12s %6s total, %6s free (%s used)\n", $6, $2, $4, $5}')"
OS_NAME="$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}")"
if command -v rpm >/dev/null 2>&1; then
  PKG_COUNT="$(rpm -qa 2>/dev/null | wc -l | awk '{print $1}')"
elif command -v dpkg-query >/dev/null 2>&1; then
  PKG_COUNT="$(dpkg-query -f '${binary:Package}\n' -W 2>/dev/null | wc -l | awk '{print $1}')"
else
  PKG_COUNT="N/A"
fi

cat > /etc/issue <<EOF
┌────────────────────────────────────────────────────┐
│     UNAUTHORIZED ACCESS IS STRICTLY PROHIBITED     │
└────────────────────────────────────────────────────┘
======================================================
 ENV      : ${ENV_NAME}
 Hostname : ${HOST}
 IP       : ${IP:-N/A}
 OS       : ${OS_NAME}
 CPU      : ${CPU} vCPU
 RAM      : ${RAM_GB} GB
 Disk : total - ${DISK_TOTAL:-N/A}, free - ${DISK_FREE:-N/A}
 Mounts:
${MOUNT_LINES:-  N/A}
 Packages : ${PKG_COUNT}
======================================================
EOF

cp -f /etc/issue /etc/issue.net
